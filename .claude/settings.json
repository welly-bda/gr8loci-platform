{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git blame*)",
      "Bash(git remote -v*)",
      "Bash(git stash list*)",
      "Bash(pnpm install*)",
      "Bash(pnpm list*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm build*)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm --filter gr8loci *)",
      "Bash(pnpm --filter @platform/*)",
      "Bash(turbo run *)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(psql --version)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(rg *)",
      "Bash(grep *)"
    ]
  }
}
